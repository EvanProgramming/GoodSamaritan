# Classic `ghp_` token for the dedicated Good Samaritan account (`repo` scope).
# Fine-grained tokens cannot currently contribute to public repositories where
# the account is not a member.
GOOD_SAMARITAN_GITHUB_TOKEN=
GOOD_SAMARITAN_GIT_NAME=Good Samaritan
GOOD_SAMARITAN_GIT_EMAIL=good-samaritan@example.invalid
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
